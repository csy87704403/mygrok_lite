# ============ Grok 账号管理平台 - 环境变量模板 ============
# 复制为 .env 并填写你的值: cp .env.example .env

# 平台管理密码 (必填! 登录管理界面 + 管理 API)
GROK_PLATFORM_ADMIN_PASSWORD=your_strong_admin_password

# 端口 (默认 18080)
GROK_PLATFORM_PORT=18080

# 账号产出目录 (CPA/账号 JSON 存放, 需挂载卷)
GROK_ACCOUNTS_DIR=/root/grok_accounts

# 公网 API Base URL (部署了隧道/域名时填, 如 https://grok.example.com/v1; 否则留空走公网IP)
GROK_PUBLIC_BASE_URL=

# 默认节点池 (逗号分隔, 留空则用内置默认)
#   - Linux/host 网络: 宿主机 Mihomo 端口, 如 8001,8002,8003 (留空用原版31端口)
#   - Docker Desktop/WSL2: mihomo 容器名, 如 mihomo:8001,mihomo:8002
# GROK_DEFAULT_NODES=mihomo:8001,mihomo:8002

# ============ 临时邮箱服务 (注册功能需要, 部署后自己配置) ============
# 临时邮箱 worker 地址 (必填才能注册新账号, 例如你自己的 Cloudflare Worker)
TEMP_MAIL_API=
TEMP_MAIL_ADMIN=

# 临时邮箱域名池 (seed 到数据库, 格式: "domain1|base_url1|admin1,domain2|base_url2|admin2")
TEMP_MAIL_DOMAINS=

# 注册脚本用的邮箱配置 (JSON, 格式样例):
# GROK_MAIL_CONFIG=[{"base_url":"https://your-mail-worker","domain":"yourdomain.com"}]
GROK_MAIL_CONFIG=
